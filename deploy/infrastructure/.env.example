# Address reachable from the VM bridge. Keep 0.0.0.0 unless host firewall rules
# provide the restriction to the libvirt network.
APT_REPO_BIND_ADDRESS=0.0.0.0
APT_REPO_PORT=8081
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://security.debian.org/debian-security

# Used by scripts/install-harbor.sh.
HARBOR_HOSTNAME=harbor.internal
HARBOR_HTTP_PORT=8080
HARBOR_DATA_DIR=/var/lib/harbor
