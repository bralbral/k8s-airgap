---
apiVersion: v1
kind: Service
metadata:
  name: argocd-public
  namespace: argocd
spec:
  type: LoadBalancer
  allocateLoadBalancerNodePorts: false
  loadBalancerIP: "{{ argocd_ip }}"
  selector:
    app.kubernetes.io/name: argocd-server
    app.kubernetes.io/instance: argocd
  ports:
    - name: http
      port: 80
      targetPort: 8080
