---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: argocd
  namespace: argocd
spec:
  parentRefs:
    - name: public
      namespace: traefik
      sectionName: web
  hostnames:
    - {{ argocd_hostname | quote }}
  rules:
    - backendRefs:
        - name: argocd-server
          port: 80
